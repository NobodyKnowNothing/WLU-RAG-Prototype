{
  "name": "wlu-policy-index",
  "private": true,
  "type": "module",
  "description": "Section-level vector index of every Laurier policy page, with weekly change detection and a search tool for agents",
  "engines": { "node": ">=22.13" },
  "bin": { "policy-index": "src/cli.mjs" },
  "scripts": {
